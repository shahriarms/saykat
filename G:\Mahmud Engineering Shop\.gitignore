# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Local Env Files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Bubblewrap / Android build files (to be ignored)
/app-release-signed.apk
/app-release-signed.aab
/app-release-unsigned.apk
/app-release-unsigned.aab
/assetlinks.json
/.bubblewrap/
android.keystore

# Database and pgAdmin data volumes - these are managed by Docker
postgres_data/
pgadmin_data/
